    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@langchain/openai": "^1.2.7",
    "dotenv": "^17.3.1",
