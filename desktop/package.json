  "main": "dist/main.js",
  "scripts": {
    "build:electron": "tsc",
    "dev:electron": "tsc -w",
    "dev:fast": "concurrently \"npm run dev:next\" \"wait-on http://localhost:3000 && npm run start:ts\"",
    "start": "\".\\node_modules\\electron\\dist\\electron.exe\" .",
    "start:ts": "\".\\node_modules\\electron\\dist\\electron.exe\" -r ts-node/register main.ts",
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:next\" \"wait-on http://localhost:3000 && npm run start\"",
    "dev:next": "cd app && npm run dev"
  },
